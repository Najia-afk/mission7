# Dockerfile.prod
# Production Docker image for Mission7 Credit Scoring API
# Uses the new modular app/ structure

FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
# Production code (new modular structure)
COPY app/ ./app/

# Exploration/training code (for feature engineering reuse)
COPY src/ ./src/

# Production models
COPY prod_models/ ./prod_models/

# Scripts (for artifact sync)
COPY scripts/ ./scripts/

# Tests
COPY tests/ ./tests/

# Entrypoint script
COPY entrypoint.sh .
RUN chmod +x entrypoint.sh

# ============================================================================
# VALIDATE PRODUCTION MODEL AT BUILD TIME
# ============================================================================
# Verifies prod_models/ contains valid model.pkl and threshold.json
# Reuses the same verify_exported_model() function from the export pipeline
# (called manually in notebook before pushing prod_models/ to git)
RUN echo "" && \
    echo " Validating production model package..." && \
    python -c "import sys; sys.path.insert(0, '/app/src'); from scripts.export_model import verify_exported_model; verify_exported_model('/app/prod_models') or exit(1)" && \
    echo " Production model validation passed!"

# Set environment variables
ENV PYTHONPATH=/app:/app/src
ENV MLFLOW_TRACKING_URI=http://mlflow:5005
ENV PYTHONUNBUFFERED=1
ENV USE_POSTGRES=true

# Expose API port (matches docker-compose.prod.yml and nginx upstream)
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Run with entrypoint (syncs artifacts then starts Gunicorn)
CMD ["./entrypoint.sh"]
